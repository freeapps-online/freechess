{
  "name": "freechessapp",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "pnpm --filter @freechessapp/web dev",
    "build": "pnpm --filter @freechessapp/web build",
    "test": "pnpm --filter @freechessapp/web test",
    "preview": "pnpm --filter @freechessapp/web preview",
    "cf:deploy": "pnpm build && wrangler pages deploy web/dist",
    "cf:preview": "pnpm build && wrangler pages deploy web/dist --branch preview"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  }
}
