{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "freechessapp",
  "pages_build_output_dir": "./web/dist",
  "compatibility_date": "2026-05-01",
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameDO"] }
  ]
}
